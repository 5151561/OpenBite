<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 只有识别菜单时联网（发去掉 EXIF 的菜单图片给所选模型）。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 新建店铺、照片又没有 GPS 时取一次粗略位置；用到时才申请。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 读相册照片里的拍摄位置；从相册选图时才申请。 -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- 拍照交给系统相机（ACTION_IMAGE_CAPTURE），不需要 CAMERA 权限。 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 饭后补记忆、纪念日提醒；第一次“已下单”时才申请。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OpenBiteApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 打开 .openbite 店铺文件。聊天软件常把类型丢成 zip / octet-stream，App 里再按文件名和内容校验。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.openbite+zip" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openbite+zip" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- 通知上的“一小时后提醒”。 -->
        <receiver
            android:name=".reminders.SnoozeReceiver"
            android:exported="false" />

        <!-- 系统相机把照片写进 cache/scan/，识别完由 App 清理。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
