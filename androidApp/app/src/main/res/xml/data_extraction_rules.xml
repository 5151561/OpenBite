<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的云备份和换机迁移（D2D）。allowBackup="false" 只管得了云备份，D2D 照常会拷数据，
  所以这里显式排除全部隐私数据：数据库（店铺位置、同行人、纪念日、短评）、照片、DataStore（口味、隐私开关、加密的 Key）、
  SharedPreferences。记忆只留在这台手机上，换机靠 .openbite 分享导入。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
